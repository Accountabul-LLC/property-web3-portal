# Client-side configuration (Vite).
# These values are compiled into the browser bundle and are public by design.
# The platform injects real values at build/runtime; never put a secret here.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-side secrets are NOT read from this file and must never be added here.
# They live only in the platform secret store and are read by edge functions
# via Deno.env.get(). Listed for reference only:
#
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET,
#   STRIPE_IDENTITY_WEBHOOK_SECRET, PAYMENTS_WEBHOOK_SECRET,
#   PAYMENTS_RECONCILE_SECRET
#   XAMAN_API_KEY, XAMAN_API_SECRET
#   CAMPAIGN_RELEASE_SIGNER_SEED, CAMPAIGN_RELEASE_SIGNER_ALGORITHM,
#   CAMPAIGN_RELEASE_CRON_SECRET
#   TRUSTLINE_SPONSOR_SECRET_MAINNET, TRUSTLINE_SPONSOR_SECRET_TESTNET
#   GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, GITHUB_APP_PRIVATE_KEY
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, LOVABLE_API_KEY, GOOGLE_MAPS_API_KEY
#   APP_URL, SITE_URL, APP_ALLOWED_ORIGIN(S), WALLET_AUDIT_LOG_IP_SALT,
#   XRPL_RECEIVING_ADDRESS
# ---------------------------------------------------------------------------
